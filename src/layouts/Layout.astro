---
import { Icon } from 'astro-icon/components';
import '../styles/global.css';
import { REGION_CITIES, SALES_PHONE, SALES_TEL, SITE_NAME } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Imagen para redes sociales (URL absoluta o ruta pública). */
  image?: string;
  /** Ruta canónica; por defecto la ruta actual sin query string. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Muestra el buscador compacto del header (se oculta donde la página ya tiene uno). */
  headerSearch?: boolean;
  /** Reserva espacio al final para una barra de acciones fija en móvil. */
  bottomBar?: boolean;
  /** Datos estructurados schema.org. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${SITE_NAME} · Encuentra negocios locales`,
  description = 'Directorio de negocios, servicios y emprendedores locales en Delicias, Meoqui, Camargo y la región. Encuentra y contacta directo por WhatsApp o teléfono.',
  image = '/og-default.png',
  canonicalPath = Astro.url.pathname,
  noindex = false,
  headerSearch = true,
  bottomBar = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const canonical = new URL(canonicalPath, site).href;
const ogImage = new URL(image, site).href;
const path = Astro.url.pathname;

const gaId = import.meta.env.PUBLIC_GA_ID;
const gaEnabled = import.meta.env.PROD && !!gaId;

const nav = [
  { href: '/categorias', label: 'Categorías' },
  { href: '/preguntas-frecuentes', label: 'Preguntas' },
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {
      gaEnabled && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body class:list={['flex min-h-dvh flex-col', bottomBar && 'pb-20 lg:pb-0']}>
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-white px-4 py-2 font-semibold text-brand-700 shadow focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Saltar al contenido
    </a>

    <header class="sticky top-0 z-30 border-b border-stone-200/80 bg-white/95 backdrop-blur-sm">
      <div class="container-page flex h-16 items-center gap-3 sm:gap-6">
        <a href="/" class="shrink-0" aria-label={`${SITE_NAME}, inicio`}>
          <img src="/logo.png" alt="" width="768" height="170" class="h-8 w-auto sm:h-9" />
        </a>

        {
          headerSearch && (
            <form action="/buscar" method="get" role="search" class="hidden max-w-md flex-1 md:block">
              <label class="relative block">
                <span class="sr-only">Buscar negocios</span>
                <Icon
                  name="lucide:search"
                  class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-stone-400"
                />
                <input
                  type="search"
                  name="q"
                  placeholder="Buscar negocios, servicios…"
                  class="field min-h-10 rounded-full bg-stone-100 pl-10 text-sm hover:border-stone-300 focus:bg-white"
                />
              </label>
            </form>
          )
        }

        <nav aria-label="Principal" class="ml-auto hidden items-center gap-1 md:flex">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="btn btn-ghost btn-sm aria-[current=page]:text-brand-700"
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a href="/anuncia-tu-negocio" class="btn btn-secondary btn-sm ml-2">
            <Icon name="lucide:store" class="h-4 w-4" />
            Anuncia tu negocio
          </a>
        </nav>

        <div class="ml-auto flex items-center gap-1 md:hidden">
          <a href="/buscar" class="btn btn-ghost btn-icon" aria-label="Buscar">
            <Icon name="lucide:search" class="h-5 w-5" />
          </a>
          <details class="group relative" data-menu>
            <summary class="btn btn-ghost btn-icon cursor-pointer list-none" aria-label="Menú">
              <Icon name="lucide:menu" class="h-5 w-5 group-open:hidden" />
              <Icon name="lucide:x" class="hidden h-5 w-5 group-open:block" />
            </summary>
            <nav
              aria-label="Menú móvil"
              class="absolute top-full right-0 mt-2 w-64 rounded-2xl border border-stone-200 bg-white p-2 shadow-lg"
            >
              {
                nav.map((item) => (
                  <a href={item.href} class="flex min-h-11 items-center rounded-xl px-3 font-medium hover:bg-stone-100">
                    {item.label}
                  </a>
                ))
              }
              <a href="/anuncia-tu-negocio" class="btn btn-primary mt-2 w-full">
                <Icon name="lucide:store" class="h-4 w-4" />
                Anuncia tu negocio
              </a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t border-stone-200 bg-white">
      <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div class="sm:col-span-2 lg:col-span-1">
          <img src="/logo.png" alt={SITE_NAME} width="768" height="170" loading="lazy" class="h-8 w-auto" />
          <p class="mt-4 max-w-xs text-sm leading-relaxed text-stone-600">
            El directorio de negocios locales de la región. Encuentras lo que necesitas y hablas directo con el
            negocio, sin intermediarios ni comisiones.
          </p>
        </div>

        <nav aria-label="Explorar">
          <h2 class="eyebrow">Explorar</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a href="/buscar" class="text-stone-700 hover:text-brand-700">Todos los negocios</a></li>
            <li><a href="/categorias" class="text-stone-700 hover:text-brand-700">Categorías</a></li>
            <li><a href="/preguntas-frecuentes" class="text-stone-700 hover:text-brand-700">Preguntas frecuentes</a></li>
          </ul>
        </nav>

        <nav aria-label="Para negocios">
          <h2 class="eyebrow">Para negocios</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a href="/anuncia-tu-negocio" class="text-stone-700 hover:text-brand-700">Anuncia tu negocio</a></li>
            <li>
              <a href={SALES_TEL} class="inline-flex items-center gap-1.5 text-stone-700 hover:text-brand-700">
                <Icon name="lucide:phone" class="h-3.5 w-3.5" />
                {SALES_PHONE}
              </a>
            </li>
          </ul>
        </nav>

        <div>
          <h2 class="eyebrow">Dónde estamos</h2>
          <p class="mt-4 text-sm leading-relaxed text-stone-700">
            {REGION_CITIES.join(' · ')} y otras localidades de Chihuahua.
          </p>
        </div>
      </div>

      <div class="border-t border-stone-100">
        <div
          class="container-page flex flex-col gap-1 py-5 text-xs text-stone-500 sm:flex-row sm:items-center sm:justify-between"
        >
          <p>© {new Date().getFullYear()} {SITE_NAME}. Hecho en Delicias, Chihuahua.</p>
          <p>
            Desarrollado por{' '}
            <a href="https://raventechnologic.com" target="_blank" rel="noopener noreferrer" class="hover:text-brand-700">
              raventechnologic.com
            </a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      // Cierra el menú móvil al tocar fuera o al presionar Escape.
      const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
      if (menu) {
        document.addEventListener('click', (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
      }
    </script>
  </body>
</html>
