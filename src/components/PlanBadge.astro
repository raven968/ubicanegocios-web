---
import { PLANS, type PlanSlug } from '../lib/api';

interface Props {
  plan: PlanSlug;
  size?: 'sm' | 'md' | 'lg';
  showName?: boolean;
}

const { plan, size = 'md', showName = false } = Astro.props;
const info = PLANS[plan];

const sizeClass = {
  sm: 'h-7 w-7 sm:h-9 sm:w-9',
  md: 'h-12 w-12',
  lg: 'h-16 w-16',
}[size];
---

{
  info && (
    <span class="inline-flex items-center gap-2" title={info.name}>
      <img
        src={info.image}
        alt={showName ? '' : `Plan ${info.name}`}
        width="256"
        height="256"
        loading="lazy"
        decoding="async"
        class={`${sizeClass} object-contain drop-shadow-sm`}
      />
      {showName && <span class="text-sm font-medium text-stone-700">{info.name}</span>}
    </span>
  )
}
