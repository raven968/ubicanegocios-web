---
import { Icon } from 'astro-icon/components';
import type { BusinessVideo } from '../lib/api';
import { youtubeId } from '../lib/youtube';

interface Props {
  videos: BusinessVideo[];
  name: string;
}

const { videos, name } = Astro.props;

const items = videos
  .map((v) => ({ ...v, ytId: youtubeId(v.url) }))
  .filter((v): v is BusinessVideo & { ytId: string } => Boolean(v.ytId));

const hasMany = items.length > 1;
const first = items[0];
const stageClass = (orientation: string) =>
  orientation === 'vertical' ? 'aspect-[9/16] w-full max-w-xs' : 'aspect-video w-full';
---

<!--
  "Facade": se muestra la miniatura y el iframe de YouTube (≈1 MB de JS) solo
  se carga cuando la persona presiona reproducir.
-->
{
  items.length > 0 && (
    <div data-videos>
      <div
        data-stage
        data-yt={first.ytId}
        class={`relative mx-auto overflow-hidden rounded-2xl bg-black ${stageClass(first.orientation)}`}
      >
        <button type="button" data-play class="group absolute inset-0 h-full w-full" aria-label={`Reproducir video de ${name}`}>
          <img
            data-poster
            src={`https://i.ytimg.com/vi/${first.ytId}/hqdefault.jpg`}
            alt=""
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover opacity-90 transition group-hover:opacity-100"
          />
          <span class="absolute inset-0 grid place-items-center">
            <span class="grid h-16 w-16 place-items-center rounded-full bg-black/70 text-white transition group-hover:scale-105 group-hover:bg-red-600">
              <Icon name="lucide:play" class="ml-1 h-7 w-7 fill-current" />
            </span>
          </span>
        </button>
      </div>

      {hasMany && (
        <ul class="scroller mt-2 sm:mx-0 sm:px-0" aria-label="Más videos">
          {items.map((v, i) => (
            <li class="shrink-0">
              <button
                type="button"
                data-index={i}
                data-yt={v.ytId}
                data-orientation={v.orientation}
                aria-current={i === 0 ? 'true' : undefined}
                class="relative block overflow-hidden rounded-lg opacity-70 ring-2 ring-transparent transition hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:ring-brand-600"
                aria-label={`Ver video ${i + 1}`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${v.ytId}/mqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-14 w-24 object-cover"
                />
                <span class="absolute inset-0 grid place-items-center">
                  <Icon name="lucide:play" class="h-5 w-5 fill-white text-white drop-shadow" />
                </span>
              </button>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

<script>
  const root = document.querySelector<HTMLElement>('[data-videos]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const thumbs = Array.from(root.querySelectorAll<HTMLElement>('[data-index]'));

    const play = (ytId: string) => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1&rel=0`;
      frame.title = 'Video de YouTube';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'absolute inset-0 h-full w-full';
      stage.replaceChildren(frame);
    };

    stage.querySelector('[data-play]')?.addEventListener('click', () => play(stage.dataset.yt!));

    thumbs.forEach((t) =>
      t.addEventListener('click', () => {
        const vertical = t.dataset.orientation === 'vertical';
        stage.classList.toggle('aspect-[9/16]', vertical);
        stage.classList.toggle('max-w-xs', vertical);
        stage.classList.toggle('aspect-video', !vertical);
        thumbs.forEach((el) => (el === t ? el.setAttribute('aria-current', 'true') : el.removeAttribute('aria-current')));
        play(t.dataset.yt!);
      }),
    );
  }
</script>
