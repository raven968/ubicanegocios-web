---
import { Icon } from 'astro-icon/components';

interface Props {
  icon?: string;
  title: string;
  description?: string;
  /** `error` cambia el tono para fallos de carga (la API no respondió). */
  tone?: 'empty' | 'error';
}
const { icon = 'lucide:search-x', title, description, tone = 'empty' } = Astro.props;
---

<div
  class="flex flex-col items-center rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-14 text-center"
  role={tone === 'error' ? 'alert' : undefined}
>
  <span
    class:list={[
      'grid h-12 w-12 place-items-center rounded-full',
      tone === 'error' ? 'bg-red-50 text-red-600' : 'bg-stone-100 text-stone-500',
    ]}
  >
    <Icon name={icon} class="h-6 w-6" />
  </span>
  <h2 class="mt-4 text-lg font-semibold">{title}</h2>
  {description && <p class="mt-1 max-w-md text-sm text-stone-600">{description}</p>}
  <div class="mt-6 flex flex-wrap justify-center gap-2 empty:hidden">
    <slot />
  </div>
</div>
