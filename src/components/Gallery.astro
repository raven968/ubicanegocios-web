---
import { Icon } from 'astro-icon/components';
import type { BusinessImage } from '../lib/api';

interface Props {
  images: BusinessImage[];
  name: string;
}
const { images, name } = Astro.props;
const hasMany = images.length > 1;
---

<!--
  Carrusel con scroll-snap nativo: swipe en móvil sin librerías. Las imágenes se
  muestran completas (object-contain): muchos negocios suben flyers y recortarlos
  esconde información. El fondo difuminado evita bandas vacías.
-->
{
  images.length > 0 && (
    <div class="gallery" data-gallery>
      <div class="relative overflow-hidden rounded-2xl bg-stone-900">
        <ul
          class="flex aspect-[4/3] snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] sm:aspect-[16/10] [&::-webkit-scrollbar]:hidden"
          data-track
          aria-label={`Fotos de ${name}`}
        >
          {images.map((img, i) => (
            <li class="relative h-full w-full shrink-0 snap-center snap-always" aria-label={`Foto ${i + 1} de ${images.length}`}>
              <img
                src={img.url}
                alt=""
                aria-hidden="true"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-2xl"
              />
              <button type="button" class="relative block h-full w-full cursor-zoom-in" data-open={i} aria-label="Ampliar foto">
                <img
                  src={img.url}
                  alt={i === 0 ? name : `${name}, foto ${i + 1}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                  class="h-full w-full object-contain"
                />
              </button>
            </li>
          ))}
        </ul>

        {hasMany && (
          <>
            <button
              type="button"
              data-step="-1"
              class="absolute top-1/2 left-3 hidden h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-stone-900 shadow transition hover:bg-white sm:grid"
              aria-label="Foto anterior"
            >
              <Icon name="lucide:chevron-left" class="h-5 w-5" />
            </button>
            <button
              type="button"
              data-step="1"
              class="absolute top-1/2 right-3 hidden h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-stone-900 shadow transition hover:bg-white sm:grid"
              aria-label="Foto siguiente"
            >
              <Icon name="lucide:chevron-right" class="h-5 w-5" />
            </button>
          </>
        )}

        <span
          class="pointer-events-none absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full bg-black/65 px-2.5 py-1 text-xs font-medium text-white"
        >
          <Icon name="lucide:images" class="h-3.5 w-3.5" />
          <span data-counter>1</span> / {images.length}
        </span>
      </div>

      {hasMany && (
        <ul class="scroller mt-2 sm:mx-0 sm:px-0" aria-label="Miniaturas">
          {images.map((img, i) => (
            <li class="shrink-0">
              <button
                type="button"
                data-thumb={i}
                aria-current={i === 0 ? 'true' : undefined}
                class="block overflow-hidden rounded-lg opacity-60 ring-2 ring-transparent transition hover:opacity-100 aria-[current=true]:opacity-100 aria-[current=true]:ring-brand-600"
                aria-label={`Ver foto ${i + 1}`}
              >
                <img src={img.url} alt="" loading="lazy" decoding="async" class="h-14 w-20 object-cover sm:h-16 sm:w-24" />
              </button>
            </li>
          ))}
        </ul>
      )}

      <dialog
        data-lightbox
        class="m-0 h-dvh max-h-none w-screen max-w-none bg-black/95 p-0 text-white backdrop:bg-black/80"
        aria-label={`Fotos de ${name}`}
      >
        <div class="flex h-full flex-col">
          <div class="flex items-center justify-between p-3">
            <span class="text-sm text-white/80">
              <span data-lb-counter>1</span> / {images.length}
            </span>
            <button type="button" data-close class="grid h-11 w-11 place-items-center rounded-full hover:bg-white/10" aria-label="Cerrar">
              <Icon name="lucide:x" class="h-6 w-6" />
            </button>
          </div>
          <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 pb-6">
            <img data-lb-img src={images[0].url} alt="" class="max-h-full max-w-full object-contain" />
            {hasMany && (
              <>
                <button
                  type="button"
                  data-lb-step="-1"
                  class="absolute left-2 grid h-12 w-12 place-items-center rounded-full bg-white/10 hover:bg-white/20"
                  aria-label="Foto anterior"
                >
                  <Icon name="lucide:chevron-left" class="h-6 w-6" />
                </button>
                <button
                  type="button"
                  data-lb-step="1"
                  class="absolute right-2 grid h-12 w-12 place-items-center rounded-full bg-white/10 hover:bg-white/20"
                  aria-label="Foto siguiente"
                >
                  <Icon name="lucide:chevron-right" class="h-6 w-6" />
                </button>
              </>
            )}
          </div>
        </div>
      </dialog>
    </div>
  )
}

<script>
  const root = document.querySelector<HTMLElement>('[data-gallery]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
    const counter = root.querySelector('[data-counter]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const lbImg = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const lbCounter = dialog.querySelector('[data-lb-counter]');
    const srcs = slides.map((s) => s.querySelector<HTMLImageElement>('button img')!.src);
    let current = 0;

    const setCurrent = (i: number) => {
      current = i;
      if (counter) counter.textContent = String(i + 1);
      thumbs.forEach((t, idx) => {
        if (idx === i) {
          t.setAttribute('aria-current', 'true');
          t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        } else t.removeAttribute('aria-current');
      });
    };

    const goTo = (i: number) => {
      const next = (i + slides.length) % slides.length;
      track.scrollTo({ left: next * track.clientWidth, behavior: 'smooth' });
    };

    // El índice visible sale del scroll (cubre swipe, flechas y teclado).
    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const i = Math.round(track.scrollLeft / track.clientWidth);
          if (i !== current) setCurrent(i);
        });
      },
      { passive: true },
    );

    root.querySelectorAll<HTMLElement>('[data-step]').forEach((btn) =>
      btn.addEventListener('click', () => goTo(current + Number(btn.dataset.step))),
    );
    thumbs.forEach((t) => t.addEventListener('click', () => goTo(Number(t.dataset.thumb))));

    const showInLightbox = (i: number) => {
      const next = (i + srcs.length) % srcs.length;
      lbImg.src = srcs[next];
      if (lbCounter) lbCounter.textContent = String(next + 1);
      current = next;
    };

    root.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) =>
      btn.addEventListener('click', () => {
        showInLightbox(Number(btn.dataset.open));
        dialog.showModal();
      }),
    );
    dialog.querySelectorAll<HTMLElement>('[data-lb-step]').forEach((btn) =>
      btn.addEventListener('click', () => showInLightbox(current + Number(btn.dataset.lbStep))),
    );
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') showInLightbox(current + 1);
      if (e.key === 'ArrowLeft') showInLightbox(current - 1);
    });
    // Al cerrar, el carrusel queda en la foto que se estaba viendo.
    dialog.addEventListener('close', () => {
      track.scrollTo({ left: current * track.clientWidth });
      setCurrent(current);
    });
  }
</script>
