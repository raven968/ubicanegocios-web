---
import { Icon } from 'astro-icon/components';

// Banda para dueños de negocio: aparece en la home y al final de los listados,
// nunca por encima de los resultados.
interface Props {
  variant?: 'band' | 'compact';
}
const { variant = 'band' } = Astro.props;
---

{
  variant === 'band' ? (
    <section class="overflow-hidden rounded-3xl bg-brand-900 text-white" aria-labelledby="owner-cta-title">
      <div class="grid items-center gap-8 px-6 py-10 sm:px-10 md:grid-cols-[1.4fr_1fr] md:py-12">
        <div>
          <p class="text-sm font-semibold text-leaf-200">¿Tienes un negocio?</p>
          <h2 id="owner-cta-title" class="mt-2 text-2xl font-bold text-white sm:text-3xl">
            Haz que los clientes de tu ciudad te encuentren
          </h2>
          <p class="mt-3 max-w-lg text-brand-100">
            Crea tu perfil con fotos, ubicación y botón de WhatsApp. Los clientes te contactan directo y no cobramos
            comisión por tus ventas.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row md:flex-col md:items-stretch">
          <a href="/anuncia-tu-negocio" class="btn btn-lg bg-white text-brand-900 hover:bg-brand-50">
            Anuncia tu negocio
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
          <p class="text-center text-sm text-brand-200">Puedes empezar aunque vendas desde casa.</p>
        </div>
      </div>
    </section>
  ) : (
    <aside class="flex flex-col items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-leaf-50 text-leaf-700">
          <Icon name="lucide:store" class="h-5 w-5" />
        </span>
        <p class="text-sm text-stone-700">
          <span class="font-semibold text-stone-900">¿Tu negocio no aparece aquí?</span> Súmalo y que te encuentren.
        </p>
      </div>
      <a href="/anuncia-tu-negocio" class="btn btn-secondary btn-sm">
        Anuncia tu negocio
      </a>
    </aside>
  )
}
