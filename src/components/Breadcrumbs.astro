---
import { Icon } from 'astro-icon/components';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Ruta de navegación" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1 text-stone-600">
    {
      items.map((item, i) => (
        <li class="flex min-w-0 items-center gap-1">
          {i > 0 && <Icon name="lucide:chevron-right" class="h-3.5 w-3.5 shrink-0 text-stone-400" />}
          {item.href ? (
            <a href={item.href} class="hover:text-brand-700 hover:underline">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="truncate text-stone-700">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
