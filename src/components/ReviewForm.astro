---
import { Icon } from 'astro-icon/components';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000/api/v1';
const labels = ['Malo', 'Regular', 'Bueno', 'Muy bueno', 'Excelente'];
---

<form id="review-form" data-slug={slug} data-api={apiUrl} class="card p-5 sm:p-6" novalidate>
  <h3 class="text-lg font-semibold">Deja tu reseña</h3>
  <p class="mt-1 text-sm text-stone-600">Tu opinión ayuda a otras personas de la región a decidir.</p>

  <!--
    Estrellas = radios reales: funcionan con teclado (flechas) y lectores de pantalla.
    Se pintan en orden inverso para que `~` ilumine las anteriores.
  -->
  <fieldset class="mt-5">
    <legend class="label">Calificación</legend>
    <div class="star-picker flex flex-row-reverse justify-end gap-1">
      {
        [5, 4, 3, 2, 1].map((n) => (
          <>
            <input type="radio" name="rating" id={`rating-${n}`} value={n} class="peer sr-only" required />
            <label
              for={`rating-${n}`}
              class="cursor-pointer rounded-md p-0.5 text-stone-300 transition"
              title={labels[n - 1]}
            >
              <Icon name="lucide:star" class="h-8 w-8 fill-current" />
              <span class="sr-only">
                {n} {n === 1 ? 'estrella' : 'estrellas'}, {labels[n - 1]}
              </span>
            </label>
          </>
        ))
      }
    </div>
  </fieldset>

  <div class="mt-4">
    <label for="review-name" class="label">Tu nombre</label>
    <input id="review-name" name="author_name" required maxlength="80" autocomplete="name" class="field" />
  </div>

  <div class="mt-4">
    <label for="review-body" class="label">Tu experiencia</label>
    <textarea
      id="review-body"
      name="body"
      required
      maxlength="2000"
      rows="4"
      placeholder="¿Qué te gustó? ¿Lo recomendarías?"
      class="field py-2.5"></textarea>
  </div>

  <p id="review-msg" class="mt-4 hidden rounded-xl px-3.5 py-2.5 text-sm" role="status" aria-live="polite"></p>

  <button type="submit" class="btn btn-primary mt-5 w-full sm:w-auto">
    <Icon name="lucide:loader-circle" class="hidden h-4 w-4 animate-spin" data-spinner />
    <span data-label>Publicar reseña</span>
  </button>
</form>

<style>
  .star-picker label:hover,
  .star-picker label:hover ~ label,
  .star-picker input:checked + label,
  .star-picker input:checked + label ~ label {
    color: var(--color-amber-400, #fbbf24);
  }
  .star-picker input:focus-visible + label {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
</style>

<script>
  const form = document.getElementById('review-form') as HTMLFormElement | null;
  if (form) {
    const msg = document.getElementById('review-msg') as HTMLElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const spinner = button.querySelector('[data-spinner]')!;
    const label = button.querySelector('[data-label]')!;

    const showMsg = (text: string, ok: boolean) => {
      msg.textContent = text;
      msg.className = `mt-4 rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-leaf-50 text-leaf-800' : 'bg-red-50 text-red-700'}`;
    };

    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      spinner.classList.toggle('hidden', !busy);
      label.textContent = busy ? 'Enviando…' : 'Publicar reseña';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const rating = Number(data.get('rating'));
      const name = String(data.get('author_name') ?? '').trim();
      const body = String(data.get('body') ?? '').trim();

      if (!rating) return showMsg('Elige una calificación de 1 a 5 estrellas.', false);
      if (!name || !body) return showMsg('Escribe tu nombre y tu experiencia.', false);

      setBusy(true);
      try {
        const res = await fetch(`${form.dataset.api}/businesses/${form.dataset.slug}/reviews`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ author_name: name, body, rating }),
        });
        if (res.ok) {
          showMsg('¡Gracias por tu reseña! La estamos publicando…', true);
          form.reset();
          setTimeout(() => location.reload(), 1200);
          return;
        }
        showMsg(
          res.status === 429
            ? 'Has enviado demasiadas reseñas. Intenta más tarde.'
            : 'No se pudo enviar la reseña. Revisa los campos.',
          false,
        );
      } catch {
        showMsg('Sin conexión. Revisa tu internet e intenta de nuevo.', false);
      }
      setBusy(false);
    });
  }
</script>
