---
import { Icon } from 'astro-icon/components';
import Stars from './Stars.astro';
import PlanBadge from './PlanBadge.astro';
import type { Business } from '../lib/api';
import { stripMarkdown } from '../lib/markdown';
import { contactActions } from '../lib/contact';
import { locationSummary } from '../lib/zones';

interface Props {
  business: Business;
  /** Las primeras tarjetas visibles cargan la imagen sin lazy (mejora LCP). */
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { business, eager = false, headingLevel: Heading = 'h3' } = Astro.props;

const cover = business.images?.[0]?.url;
const category = business.categories?.[0]?.name;
const location = locationSummary(business.zones ?? []);
const descriptionPreview = business.description ? stripMarkdown(business.description) : '';
const { whatsapp, call } = contactActions(business);
const href = `/negocio/${business.slug}`;
---

<!--
  Toda la tarjeta es clickeable con un enlace "estirado" sobre el nombre;
  los botones de contacto quedan encima (z-10) para contactar sin entrar a la ficha.
  Móvil: fila compacta (imagen a la izquierda) para escanear más resultados por pantalla.
-->
<article
  class="group relative flex gap-3 rounded-2xl border border-stone-200 bg-white p-3 transition hover:border-stone-300 hover:shadow-[0_6px_20px_-8px_rgba(0,0,0,.18)] sm:flex-col sm:gap-0 sm:p-0"
>
  <div
    class="relative aspect-square w-24 shrink-0 overflow-hidden rounded-xl bg-stone-100 sm:aspect-[4/3] sm:w-full sm:rounded-none sm:rounded-t-2xl"
  >
    {
      cover ? (
        <img
          src={cover}
          alt=""
          width="400"
          height="300"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : 'auto'}
          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="grid h-full w-full place-items-center text-stone-300">
          <Icon name="lucide:store" class="h-8 w-8" />
        </div>
      )
    }
    {
      business.plan && (
        <div class="absolute top-1 right-1 sm:top-2 sm:right-2">
          <PlanBadge plan={business.plan} size="sm" />
        </div>
      )
    }
  </div>

  <div class="flex min-w-0 flex-1 flex-col sm:p-4">
    {category && <p class="truncate text-xs font-medium text-brand-700">{category}</p>}
    <Heading class="mt-0.5 line-clamp-2 text-[0.9375rem] leading-snug font-semibold sm:text-base">
      <a href={href} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none">
        {business.name}
      </a>
    </Heading>

    <div class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-[0.8125rem] text-stone-500">
      {business.reviews_count > 0 && (
        <Stars rating={business.average_rating} count={business.reviews_count} variant="compact" />
      )}
      {location && (
        <span class="inline-flex min-w-0 items-center gap-1">
          <Icon name="lucide:map-pin" class="h-3.5 w-3.5 shrink-0" />
          <span class="truncate">{location}</span>
        </span>
      )}
    </div>

    {
      descriptionPreview && (
        <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-stone-600 max-sm:hidden">{descriptionPreview}</p>
      )
    }

    {
      (whatsapp || call) && (
        <div class="relative z-10 mt-auto flex gap-2 pt-3">
          {whatsapp && (
            <a
              href={whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-contact flex-1 sm:flex-none"
              aria-label={`WhatsApp de ${business.name}`}
            >
              <Icon name="simple-icons:whatsapp" class="h-3.5 w-3.5" />
              WhatsApp
            </a>
          )}
          {call && (
            <a href={call} class="btn btn-sm btn-secondary flex-1 sm:flex-none" aria-label={`Llamar a ${business.name}`}>
              <Icon name="lucide:phone" class="h-3.5 w-3.5" />
              Llamar
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  /* El foco del enlace estirado se dibuja en toda la tarjeta. */
  article:has(h2 a:focus-visible, h3 a:focus-visible) {
    outline: 2px solid var(--color-brand-600);
    outline-offset: 2px;
  }
</style>
