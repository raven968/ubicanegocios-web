---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import BusinessGrid from '../components/BusinessGrid.astro';
import ChipNav from '../components/ChipNav.astro';
import EmptyState from '../components/EmptyState.astro';
import OwnerCta from '../components/OwnerCta.astro';
import Pagination from '../components/Pagination.astro';
import SearchBar from '../components/SearchBar.astro';
import { getBusinessesPage, getCategories, getZones, type BusinessPage } from '../lib/api';
import { zoneLabel } from '../lib/zones';

const sp = Astro.url.searchParams;
const q = sp.get('q')?.trim() ?? '';
const zoneSlug = sp.get('zona')?.trim() ?? '';
const categorySlug = sp.get('categoria')?.trim() ?? '';
const subSlug = sp.get('sub')?.trim() ?? '';
const page = Math.max(1, Number(sp.get('page')) || 1);

// Solo categoría (sin texto ni zona) ya tiene su propia página: evita contenido duplicado.
if (categorySlug && !q && !zoneSlug && !subSlug && page === 1) {
  return Astro.redirect(`/categoria/${categorySlug}`, 301);
}

const [zones, categories] = await Promise.all([getZones().catch(() => []), getCategories().catch(() => [])]);
const zone = zones.find((z) => z.slug === zoneSlug) ?? null;
const category = categories.find((c) => c.slug === categorySlug) ?? null;
const sub = category?.subcategories.find((s) => s.slug === subSlug) ?? null;

// sort=plan: los negocios se listan por plan (fundador → ubitag) y luego por fecha.
const params: Record<string, string> = { sort: 'plan', per_page: '24', page: String(page) };
if (q) params.search = q;
if (zone) params.zone = zone.slug;
if (category) params.category = category.slug;
if (sub) params.subcategory = sub.slug;

let failed = false;
const result: BusinessPage = await getBusinessesPage(params).catch(() => {
  failed = true;
  return { data: [], meta: { current_page: 1, last_page: 1, per_page: 24, total: 0 } };
});
const { data: businesses, meta } = result;

const place = zone ? zoneLabel(zone) : null;
const heading = q
  ? `Resultados para “${q}”`
  : category
    ? `${sub?.name ?? category.name}${place ? ` en ${place}` : ''}`
    : place
      ? `Negocios en ${place}`
      : 'Todos los negocios';

/** Construye /buscar conservando los filtros actuales y aplicando cambios. */
function searchHref(changes: Record<string, string | null>) {
  const next = new URLSearchParams();
  const merged: Record<string, string | null> = { q, zona: zoneSlug, categoria: categorySlug, sub: subSlug, ...changes };
  // Cambiar de categoría invalida la subcategoría.
  if ('categoria' in changes && !('sub' in changes)) merged.sub = null;
  for (const [k, v] of Object.entries(merged)) if (v) next.set(k, v);
  const qs = next.toString();
  return `/buscar${qs ? `?${qs}` : ''}`;
}

// Las categorías con más negocios primero: son las que más se buscan.
const activeCategories = categories
  .filter((c) => c.businesses_count > 0)
  .sort((a, b) => b.businesses_count - a.businesses_count);
const categoryChips = [
  { href: searchHref({ categoria: null }), label: 'Todas', current: !category },
  // La categoría activa va primero para que siga visible con la fila colapsada.
  ...[...activeCategories]
    .sort((a, b) => Number(b.slug === category?.slug) - Number(a.slug === category?.slug))
    .map((c) => ({
      href: searchHref({ categoria: c.slug }),
      label: c.name,
      current: c.slug === category?.slug,
    })),
];
const subChips = category?.subcategories.length
  ? [
      { href: searchHref({ sub: null }), label: `Todo ${category.name}`, current: !sub },
      ...category.subcategories.map((s) => ({
        href: searchHref({ sub: s.slug }),
        label: s.name,
        current: s.slug === sub?.slug,
      })),
    ]
  : [];

const activeFilters = [
  zone && { label: place!, icon: 'lucide:map-pin', clear: searchHref({ zona: null }) },
  category && { label: category.name, icon: 'lucide:tag', clear: searchHref({ categoria: null }) },
].filter(Boolean) as { label: string; icon: string; clear: string }[];

const resultLabel = `${meta.total} ${meta.total === 1 ? 'negocio' : 'negocios'}`;
---

<Layout
  title={`${heading} · UbicaNegocios`}
  description={`Encuentra ${heading.toLowerCase()} en UbicaNegocios: negocios locales con contacto directo por WhatsApp y teléfono.`}
  headerSearch={false}
  noindex={Boolean(q) || page > 1}
>
  <div class="border-b border-stone-200 bg-white">
    <div class="container-page py-6 sm:py-8">
      <SearchBar zones={zones} q={q} zone={zone?.slug ?? ''} category={category?.slug ?? ''} autofocus={!q && !zone && !category} />
    </div>
  </div>

  <div class="container-page pt-6 sm:pt-8">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h1 class="text-2xl font-bold sm:text-3xl">{heading}</h1>
      {!failed && <p class="text-sm text-stone-600" aria-live="polite">{resultLabel}</p>}
    </div>

    {
      activeFilters.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2" aria-label="Filtros activos">
          {activeFilters.map((f) => (
            <li>
              <a
                href={f.clear}
                class="badge min-h-8 gap-1.5 bg-brand-50 px-3 text-sm text-brand-800 hover:bg-brand-100"
                aria-label={`Quitar filtro ${f.label}`}
              >
                <Icon name={f.icon} class="h-3.5 w-3.5" />
                {f.label}
                <Icon name="lucide:x" class="h-3.5 w-3.5" />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-5 space-y-3">
      {activeCategories.length > 0 && <ChipNav label="Filtrar por categoría" chips={categoryChips} />}
      {subChips.length > 0 && <ChipNav label="Filtrar por subcategoría" chips={subChips} />}
    </div>

    <div class="mt-6">
      {
        failed ? (
          <EmptyState
            tone="error"
            icon="lucide:wifi-off"
            title="No pudimos cargar los negocios"
            description="Hubo un problema de conexión. Intenta de nuevo en unos segundos."
          >
            <a href={Astro.url.pathname + Astro.url.search} class="btn btn-primary">
              Reintentar
            </a>
          </EmptyState>
        ) : businesses.length > 0 ? (
          <>
            <BusinessGrid businesses={businesses} eagerCount={3} />
            <Pagination current={meta.current_page} last={meta.last_page} url={Astro.url} />
          </>
        ) : (
          <EmptyState
            title={q ? `No encontramos resultados para “${q}”` : 'Aún no hay negocios con estos filtros'}
            description="Prueba con otra palabra, quita algún filtro o explora por categoría."
          >
            {zone && (
              <a href={searchHref({ zona: null })} class="btn btn-secondary">
                Buscar en toda la región
              </a>
            )}
            {category && (
              <a href={searchHref({ categoria: null })} class="btn btn-secondary">
                Quitar categoría
              </a>
            )}
            <a href="/categorias" class="btn btn-primary">
              Ver categorías
            </a>
          </EmptyState>
        )
      }
    </div>

    <div class="mt-12">
      <OwnerCta variant="compact" />
    </div>
  </div>
</Layout>
