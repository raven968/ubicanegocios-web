---
import Layout from '../layouts/Layout.astro';
import BusinessCard from '../components/BusinessCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { getBusinesses, getZones } from '../lib/api';

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const zoneSlug = Astro.url.searchParams.get('zona')?.trim() ?? '';

const zones = await getZones().catch(() => []);
const zone = zones.find((z) => z.slug === zoneSlug) ?? null;

// Sin término se puede seguir filtrando: una zona sola ya es una búsqueda válida.
const params: Record<string, string> = {};
if (q) params.search = q;
if (zone) params.zone = zone.slug;

// sort=plan: los negocios se listan por plan (fundador → ubitag) y luego por fecha.
const businesses = Object.keys(params).length
  ? await getBusinesses({ ...params, sort: 'plan' }).catch(() => [])
  : [];

const heading = q ? `Resultados para “${q}”` : zone ? `Negocios en ${zone.name}` : 'Buscar negocios';
const emptyText = q
  ? `No encontramos negocios para “${q}”${zone ? ` en ${zone.name}` : ''}.`
  : `Todavía no hay negocios en ${zone?.name}.`;
---

<Layout title={q ? `Resultados para "${q}"` : zone ? `Negocios en ${zone.name}` : 'Buscar'}>
  <h1 class="mb-2 text-2xl font-bold text-gray-900">{heading}</h1>

  {
    zone && q && (
      <p class="mb-4 text-sm text-gray-500">
        Filtrando por zona <span class="font-medium text-gray-700">{zone.name}</span>.
      </p>
    )
  }

  <div class="mb-6 max-w-2xl">
    <SearchBar zones={zones} q={q} zone={zone?.slug ?? ''} />
  </div>

  {
    Object.keys(params).length > 0 && businesses.length === 0 && (
      <p class="rounded-lg border border-dashed border-gray-300 p-8 text-center text-gray-500">
        {emptyText}
      </p>
    )
  }

  {
    businesses.length > 0 && (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {businesses.map((b) => (
          <BusinessCard business={b} />
        ))}
      </div>
    )
  }
</Layout>
