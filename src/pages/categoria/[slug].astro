---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BusinessGrid from '../../components/BusinessGrid.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import ChipNav from '../../components/ChipNav.astro';
import EmptyState from '../../components/EmptyState.astro';
import OwnerCta from '../../components/OwnerCta.astro';
import Pagination from '../../components/Pagination.astro';
import SearchBar from '../../components/SearchBar.astro';
import { getBusinessesPage, getCategories, getZones } from '../../lib/api';
import { breadcrumbJsonLd } from '../../lib/seo';

const { slug } = Astro.params;
const [categories, zones] = await Promise.all([getCategories(), getZones().catch(() => [])]);
const category = categories.find((c) => c.slug === slug);

if (!category) {
  return Astro.rewrite('/404');
}

const subSlug = Astro.url.searchParams.get('sub') ?? '';
const sub = category.subcategories.find((s) => s.slug === subSlug) ?? null;
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

// sort=plan: los negocios se listan por plan (fundador → ubitag) y luego por fecha.
const params: Record<string, string> = { category: category.slug, sort: 'plan', per_page: '24', page: String(page) };
if (sub) params.subcategory = sub.slug;

let failed = false;
const { data: businesses, meta } = await getBusinessesPage(params).catch(() => {
  failed = true;
  return { data: [], meta: { current_page: 1, last_page: 1, per_page: 24, total: 0 } };
});

const subChips = [
  { href: `/categoria/${category.slug}`, label: 'Todas', current: !sub },
  ...category.subcategories.map((s) => ({
    href: `/categoria/${category.slug}?sub=${s.slug}`,
    label: s.name,
    current: s.slug === sub?.slug,
  })),
];

const title = sub ? `${sub.name} · ${category.name}` : category.name;
const crumbs = [
  { href: '/', label: 'Inicio' },
  { href: '/categorias', label: 'Categorías' },
  ...(sub ? [{ href: `/categoria/${category.slug}`, label: category.name }, { label: sub.name }] : [{ label: category.name }]),
];
const canonicalPath = `/categoria/${category.slug}${sub ? `?sub=${sub.slug}` : ''}${page > 1 ? `${sub ? '&' : '?'}page=${page}` : ''}`;
---

<Layout
  title={`${title} en Delicias y la región · UbicaNegocios`}
  description={`${meta.total} negocios de ${title.toLowerCase()} en Delicias, Meoqui, Camargo y la región. Compara, mira fotos y contacta directo por WhatsApp o teléfono.`}
  canonicalPath={canonicalPath}
  jsonLd={breadcrumbJsonLd(crumbs, Astro.site!)}
>
  <div class="border-b border-stone-200 bg-white">
    <div class="container-page py-6 sm:py-8">
      <Breadcrumbs items={crumbs} />
      <div class="mt-4 flex items-center gap-4">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-brand-50 text-brand-700 sm:h-14 sm:w-14">
          <CategoryIcon name={category.icon} class="h-6 w-6 sm:h-7 sm:w-7" />
        </span>
        <div class="min-w-0">
          <h1 class="text-2xl font-bold sm:text-3xl">{sub?.name ?? category.name}</h1>
          {!failed && (
            <p class="mt-0.5 text-sm text-stone-600">
              {meta.total} {meta.total === 1 ? 'negocio' : 'negocios'}
              {sub && ` en ${category.name}`}
            </p>
          )}
        </div>
      </div>

      <div class="mt-6">
        <SearchBar zones={zones} category={category.slug} />
      </div>
    </div>
  </div>

  <div class="container-page pt-6">
    {category.subcategories.length > 0 && <ChipNav label="Subcategorías" chips={subChips} />}

    <div class="mt-6">
      {
        failed ? (
          <EmptyState
            tone="error"
            icon="lucide:wifi-off"
            title="No pudimos cargar los negocios"
            description="Hubo un problema de conexión. Intenta de nuevo en unos segundos."
          >
            <a href={Astro.url.pathname + Astro.url.search} class="btn btn-primary">
              Reintentar
            </a>
          </EmptyState>
        ) : businesses.length > 0 ? (
          <>
            <BusinessGrid businesses={businesses} eagerCount={3} headingLevel="h2" />
            <Pagination current={meta.current_page} last={meta.last_page} url={Astro.url} />
          </>
        ) : (
          <EmptyState
            icon="lucide:store"
            title={`Aún no hay negocios en ${sub?.name ?? category.name}`}
            description="Estamos sumando negocios todo el tiempo. Mientras tanto, explora otras categorías."
          >
            {sub && (
              <a href={`/categoria/${category.slug}`} class="btn btn-secondary">
                Ver todo {category.name}
              </a>
            )}
            <a href="/categorias" class="btn btn-primary">
              Ver categorías
            </a>
          </EmptyState>
        )
      }
    </div>

    <div class="mt-12">
      <OwnerCta variant="compact" />
    </div>
  </div>
</Layout>
