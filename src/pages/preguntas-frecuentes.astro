---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { PROMO_CODE, SALES_PHONE as PHONE, SALES_TEL, SALES_WHATSAPP } from '../lib/site';

type Block =
  | { type: 'text'; value: string }
  | { type: 'highlight'; value: string }
  | { type: 'list'; value: string[] };

interface Faq {
  id: string;
  icon: string;
  question: string;
  answer: Block[];
}

const faqs: Faq[] = [
  {
    id: 'como-ingresar',
    icon: 'lucide:user-plus',
    question: '¿Cómo puedo ingresar a UbicaNegocios?',
    answer: [
      { type: 'text', value: 'Es muy fácil.' },
      { type: 'text', value: `Comunícate con nosotros al ${PHONE} y te ayudaremos con tu registro.` },
      {
        type: 'highlight',
        value: `Además, al mencionar la palabra clave ${PROMO_CODE}, obtienes 20% de descuento en tu primer pago.`,
      },
    ],
  },
  {
    id: 'quienes-somos',
    icon: 'lucide:users',
    question: '¿Quiénes somos?',
    answer: [
      {
        type: 'text',
        value:
          'UbicaNegocios.com es un catálogo digital creado para ayudar a negocios, emprendedores y prestadores de servicios a tener mayor presencia en internet.',
      },
      {
        type: 'text',
        value: 'Ayudamos a que las personas encuentren negocios, productos y servicios de manera sencilla.',
      },
      {
        type: 'text',
        value:
          'No somos vendedores ni intermediarios. El cliente se comunica directamente con cada negocio. Por eso nuestro concepto es:',
      },
      { type: 'highlight', value: 'Encuentra, Conecta y Vende.' },
    ],
  },
  {
    id: 'objetivo',
    icon: 'lucide:target',
    question: '¿Cuál es nuestro objetivo?',
    answer: [
      { type: 'text', value: 'Nuestro objetivo es muy sencillo:' },
      {
        type: 'highlight',
        value: 'Ayudar a las personas a encontrar lo que necesitan y ayudar a los negocios a ser encontrados.',
      },
      {
        type: 'text',
        value:
          'Queremos que más negocios, pequeños o grandes, puedan tener presencia en internet de una manera accesible.',
      },
    ],
  },
  {
    id: 'de-donde-somos',
    icon: 'lucide:map-pin',
    question: '¿De dónde somos?',
    answer: [
      { type: 'text', value: 'UbicaNegocios.com nació en Delicias, Chihuahua, México.' },
      {
        type: 'text',
        value:
          'Nuestro proyecto comenzó para apoyar al comercio local y facilitar que los negocios de la región puedan ser encontrados en internet.',
      },
      { type: 'text', value: 'Seguimos creciendo para llegar a más ciudades.' },
    ],
  },
  {
    id: 'donde-estamos',
    icon: 'lucide:map',
    question: '¿En qué lugares estamos?',
    answer: [
      { type: 'text', value: 'Actualmente tenemos presencia principalmente en:' },
      { type: 'list', value: ['Delicias', 'Meoqui', 'Camargo', 'Jiménez', 'Parral', 'Otras localidades de la región'] },
      { type: 'text', value: 'Continuaremos agregando nuevas ciudades y negocios.' },
    ],
  },
  {
    id: 'tipos-de-negocios',
    icon: 'lucide:store',
    question: '¿Qué tipos de negocios pueden ingresar?',
    answer: [
      {
        type: 'text',
        value:
          'Pueden ingresar negocios, emprendedores y personas que ofrezcan productos o servicios. Por ejemplo:',
      },
      {
        type: 'list',
        value: [
          'Restaurantes y comercios',
          'Emprendedores desde casa',
          'Vendedores por catálogo',
          'Profesionistas y oficios',
          'Estéticas y barberías',
          'Empresas',
          'Vendedores ambulantes',
          'Venta de vehículos',
          'Venta y renta de propiedades',
          'Hospedajes',
          'Negocios que venden por redes sociales',
        ],
      },
      { type: 'text', value: 'Siempre que cumplan con las políticas de UbicaNegocios.com.' },
    ],
  },
  {
    id: 'negocio-pequeno',
    icon: 'lucide:home',
    question: '¿Puedo registrarme si mi negocio es pequeño o vendo desde mi casa?',
    answer: [
      { type: 'text', value: 'Sí. No necesitas tener un local.' },
      {
        type: 'text',
        value:
          'Puedes ingresar si vendes desde casa, por pedido, redes sociales, WhatsApp o si apenas estás comenzando tu negocio.',
      },
      {
        type: 'highlight',
        value: '¡Si tienes un producto o servicio que ofrecer, puedes formar parte de UbicaNegocios!',
      },
    ],
  },
  {
    id: 'beneficios',
    icon: 'lucide:sparkles',
    question: '¿Qué beneficios tengo al formar parte de UbicaNegocios?',
    answer: [
      {
        type: 'list',
        value: [
          'Perfil dentro de UbicaNegocios.com',
          'Información de tus productos o servicios',
          'Mayor presencia en internet',
          'Mayor facilidad para que nuevos clientes te encuentren',
          'Contacto directo con tus clientes',
          'Presencia en nuestro catálogo digital',
          'Difusión dentro de estrategias generales de UbicaNegocios',
          'Opciones para destacar tu negocio',
          'Actualización de información según tu membresía',
          'Participación en campañas o dinámicas especiales cuando corresponda',
        ],
      },
      { type: 'highlight', value: 'UbicaNegocios no cobra comisión por tus ventas.' },
      { type: 'text', value: 'El cliente encuentra tu negocio y se comunica directamente contigo.' },
    ],
  },
  {
    id: 'facturas',
    icon: 'lucide:receipt',
    question: '¿UbicaNegocios emite facturas?',
    answer: [
      { type: 'text', value: 'Por el momento no emitimos facturas.' },
      { type: 'text', value: 'Actualmente nos encontramos realizando los trámites correspondientes ante el SAT.' },
      { type: 'text', value: 'Cuando el servicio de facturación esté disponible, lo informaremos a nuestros clientes.' },
    ],
  },
];

const crumbs = [{ href: '/', label: 'Inicio' }, { label: 'Preguntas frecuentes' }];

// FAQPage: las respuestas en texto plano, unidas por bloque.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer.map((b) => (b.type === 'list' ? b.value.join(', ') : b.value)).join(' '),
    },
  })),
};
---

<Layout
  title="Preguntas frecuentes · UbicaNegocios"
  description="Resolvemos las dudas más comunes sobre UbicaNegocios: cómo registrarte, quiénes somos, dónde estamos y qué beneficios tiene formar parte del catálogo."
  jsonLd={[faqJsonLd, breadcrumbJsonLd(crumbs, Astro.site!)]}
>
  <div class="container-page pt-6">
    <Breadcrumbs items={crumbs} />

    <div class="mx-auto mt-8 max-w-3xl">
      <h1 class="text-2xl font-bold sm:text-4xl">Preguntas frecuentes</h1>
      <p class="mt-2 text-stone-600">
        Todo lo que necesitas saber sobre UbicaNegocios: quiénes somos, cómo registrar tu negocio y qué beneficios
        obtienes.
      </p>

      <div class="mt-8 space-y-3">
        {
          faqs.map((faq, i) => (
            <details
              id={faq.id}
              name="faq"
              open={i === 0}
              class="group card overflow-hidden transition open:border-stone-300 open:shadow-[0_6px_20px_-12px_rgba(0,0,0,.2)]"
            >
              <summary class="flex min-h-16 cursor-pointer list-none items-center gap-3 px-4 py-3 sm:px-5">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-700 transition group-open:bg-brand-600 group-open:text-white">
                  <Icon name={faq.icon} class="h-5 w-5" />
                </span>
                <h2 class="min-w-0 flex-1 text-left text-base font-semibold sm:text-lg">{faq.question}</h2>
                <Icon
                  name="lucide:chevron-down"
                  class="h-5 w-5 shrink-0 text-stone-400 transition group-open:rotate-180 group-open:text-brand-700"
                />
              </summary>

              <div class="space-y-3 border-t border-stone-100 px-4 pt-4 pb-5 text-[0.9375rem] leading-relaxed text-stone-700 sm:px-5 sm:pl-[4.25rem]">
                {faq.answer.map((block) =>
                  block.type === 'list' ? (
                    <ul class="grid gap-2 sm:grid-cols-2">
                      {block.value.map((item) => (
                        <li class="flex items-start gap-2">
                          <Icon name="lucide:check" class="mt-1 h-4 w-4 shrink-0 text-leaf-700" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  ) : block.type === 'highlight' ? (
                    <p class="rounded-xl bg-leaf-50 px-4 py-3 font-medium text-leaf-800">{block.value}</p>
                  ) : (
                    <p>{block.value}</p>
                  ),
                )}

                {i === 0 && (
                  <div class="flex flex-col gap-2 pt-1 sm:flex-row">
                    <a href={SALES_WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-contact">
                      <Icon name="simple-icons:whatsapp" class="h-4 w-4" />
                      Escríbenos por WhatsApp
                    </a>
                    <a href={SALES_TEL} class="btn btn-secondary">
                      <Icon name="lucide:phone" class="h-4 w-4" />
                      {PHONE}
                    </a>
                  </div>
                )}
              </div>
            </details>
          ))
        }
      </div>

      <section class="card mt-10 px-6 py-8 text-center">
        <h2 class="text-xl font-bold">¿Te quedó alguna duda?</h2>
        <p class="mx-auto mt-2 max-w-md text-sm text-stone-600">
          Comunícate con nosotros y con gusto te ayudamos a registrar tu negocio. Menciona la palabra clave{' '}
          <span class="font-semibold text-leaf-800">{PROMO_CODE}</span> y obtén 20% de descuento en tu primer pago.
        </p>
        <div class="mt-5 flex flex-col justify-center gap-2 sm:flex-row">
          <a href={SALES_WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-contact">
            <Icon name="simple-icons:whatsapp" class="h-4 w-4" />
            WhatsApp
          </a>
          <a href="/anuncia-tu-negocio" class="btn btn-secondary">Cómo anunciar mi negocio</a>
        </div>
      </section>
    </div>
  </div>
</Layout>
