---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import OwnerCta from '../components/OwnerCta.astro';
import { getCategories } from '../lib/api';
import { breadcrumbJsonLd } from '../lib/seo';

const categories = await getCategories();
// Las categorías vacías van al final: siguen siendo navegables, pero no estorban.
const sorted = [...categories].sort((a, b) => Number(b.businesses_count > 0) - Number(a.businesses_count > 0));
const crumbs = [{ href: '/', label: 'Inicio' }, { label: 'Categorías' }];
---

<Layout
  title="Categorías de negocios · UbicaNegocios"
  description="Explora negocios locales por categoría: alimentos, belleza, oficios, salud, autos, eventos y más en Delicias y la región."
  jsonLd={breadcrumbJsonLd(crumbs, Astro.site!)}
>
  <div class="container-page pt-6">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-4 text-2xl font-bold sm:text-3xl">Explora por categoría</h1>
    <p class="mt-1 text-stone-600">Elige una categoría para ver los negocios de la región.</p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sorted.map((cat) => (
          <li class="card flex flex-col p-5">
            <a href={`/categoria/${cat.slug}`} class="group flex items-center gap-3">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-100">
                <CategoryIcon name={cat.icon} class="h-5 w-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-semibold text-stone-900 group-hover:text-brand-700">{cat.name}</span>
                <span class="text-sm text-stone-500">
                  {cat.businesses_count > 0
                    ? `${cat.businesses_count} ${cat.businesses_count === 1 ? 'negocio' : 'negocios'}`
                    : 'Próximamente'}
                </span>
              </span>
            </a>
            {cat.subcategories.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5 border-t border-stone-100 pt-4 text-sm">
                {cat.subcategories.slice(0, 8).map((s) => (
                  <li>
                    <a href={`/categoria/${cat.slug}?sub=${s.slug}`} class="text-stone-600 hover:text-brand-700 hover:underline">
                      {s.name}
                    </a>
                  </li>
                ))}
                {cat.subcategories.length > 8 && (
                  <li>
                    <a href={`/categoria/${cat.slug}`} class="font-medium text-brand-700 hover:underline">
                      +{cat.subcategories.length - 8} más
                    </a>
                  </li>
                )}
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <div class="mt-14">
      <OwnerCta />
    </div>
  </div>
</Layout>
